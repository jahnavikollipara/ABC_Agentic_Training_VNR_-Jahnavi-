        "jsCode": "const question = $json.body?.message || \"\";\n\nlet historyRaw = $json.body?.history;\nlet historyArray = [];\n\ntry {\n  historyArray = typeof historyRaw === \"string\"\n    ? JSON.parse(historyRaw)\n    : historyRaw || [];\n} catch (e) {\n  historyArray = [];\n}\n\nconst history = historyArray\n  .map(h => `${h.role}: ${h.content}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    question,\n    original: question,\n    mode: $json.body?.mode || \"auto\",\n    history: history,\n    hasFiles: Object.keys($binary || {}).length > 0,\n    fileNames: Object.keys($binary || {}),\n    timestamp: new Date().toISOString()\n  },\n  binary: $binary\n}];"
      },
